DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
DATABASE_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Notifications -- email (leave EMAIL_HOST unset to just print emails to the console instead)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-account@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=husehold@example.com

# Notifications -- web push (generate once with `python manage.py generate_vapid_keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=your-account@example.com

# Google Calendar (one-way, read-only sync) -- from a Google Cloud OAuth
# client (Web application type); see household/services/google_calendar.py.
# Register this environment's redirect URI (e.g. http://localhost:8000/api/google-calendar/callback/
# for dev, https://<your-host>/api/google-calendar/callback/ for prod) in
# Google Cloud Console under the same client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the OAuth callback sends the browser back to once linking is done.
FRONTEND_URL=http://localhost:3000

# Shopping list auto-categorization -- Claude API key, used only as a
# fallback for ingredients the built-in dictionary doesn't recognize (see
# household/services/ingredient_categorization.py). Leave blank to skip the
# LLM fallback entirely (unrecognized items just stay uncategorized).
ANTHROPIC_API_KEY=
